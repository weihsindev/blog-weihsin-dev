{
  // 純靜態站:只上傳 dist 當靜態資源,不需要 Cloudflare adapter。
  // 這個檔案存在,wrangler 就不會自己去猜設定並執行 `astro add cloudflare`。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blog-weihsin-dev",
  "compatibility_date": "2026-09-16",
  // 網域宣告在這裡,部署時一併確保 custom domain 存在,不必在 dashboard 手動掛。
  "routes": [
    { "pattern": "blog.weihsin.dev", "custom_domain": true }
  ],
  // 找不到的路徑回傳 dist/404.html。
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
