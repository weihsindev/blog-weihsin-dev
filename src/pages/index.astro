---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const fmt = new Intl.DateTimeFormat('en-CA', { timeZone: 'UTC' });

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="blog — weihsin.dev" description="技術學習歷程。">
  <div class="row">
    <div class="rail"><div class="rail-num">01</div></div>
    <div class="body">
      {posts.length === 0 ? (
        <p class="empty">還沒有文章。</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <span class="post-date">{fmt.format(post.data.date)}</span>
              <h2 class="post-title"><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
              {post.data.summary && <p class="post-summary">{post.data.summary}</p>}
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</Base>
